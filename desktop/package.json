{
  "name": "giay-dep-store-desktop",
  "version": "1.0.0",
  "description": "Desktop Application Wrapper cho Hệ thống Quản lý Bán hàng Giày Đẹp Store",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Giày Đẹp Store Team",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.giaydepstore.desktop",
    "productName": "Giày Đẹp Store",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Giày Đẹp Store"
    }
  }
}
